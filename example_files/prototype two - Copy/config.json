{
  "_doc": {
    "purpose": "Consolidated config for prototype two (paths, data, model, training, inference, viewer)",
    "usage": [
      "Infer: python infer.py --config config.json",
      "Viewer: python heatmap_viewer.py --config heatmap_viewer_config.json or point to this file"
    ]
  },

  "paths": {
    "outputs_root": "data/outputs"
  },
  "seed": 42,
  "device": "auto",
  "model_type": "cnn",

  "data": {
    "test_field_path": [
      "data/testing data"
    ],
    "train_field_path": [
      "data/training data/vector/Laminar_sparse_flow_vectors_large.csv",
      "data/training data/vector/Turbulent_sparse_flow_vectors_large.csv"
    ],
    "train_data_kind": "vector",
    "tile_size": [256, 256],
    "tile_stride": [256, 256],
    "add_magnitude": true,
    "normalize": true,
    "limit_tiles": null
  },

  "model": {
    "num_classes": 2,
    "conv_channels": [32, 64, 128, 256],
    "kernel_size": 3,
    "pool_every": 1,
    "dropout": 0.1,
    "use_batchnorm": true,
    "dilations": [1, 2, 4, 4]
  },

  "training": {
    "batch_size": 16,
    "num_workers": 0,
    "pin_memory": false,
    "val_source_labels":[0,1],
    "val_split": 0.2,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "optimizer": "adamw",
    "scheduler": "none",
    "max_epochs": 50,
    "train_source_labels": [2, 1]
  },

  "inference": {
    "use_test": true,
    "file_labels": "data/testing data/file_name.csv",
    "file_summary": "data/outputs/file_predictions.csv",
    "inference_tile_size": [77, 128],
    "inference_tile_stride": [77, 32],
    "recurse": true,
    "generate_heatmap": true,
    "generate_confusion_matrix": true,
    "show_heatmap": false,
    "heatmap_class": 0,
    "cm_csv": "data/outputs/confusion_matrix.csv",
    "cm_png": "data/outputs/confusion_matrix.png",
    "heatmaps_dir": "data/outputs/heatmaps",
    "stitched_heatmap": "data/outputs/stitched_heatmap.png",
    "labels_npy": "",
    "class_names": ["turbulent","laminar" ]
  },

  "viewer": {
    "viewer_values_csv": "data/testing data/heatmap_values_example.csv",
    "viewer_title": "Stitched Heatmap (Example)",
    "viewer_cmap": "viridis",
    "viewer_no_show": false,
    "viewer_save": "data/outputs/viewer_heatmap.png",
    "viewer_rows": 4,
    "viewer_cols": 4
  }
}
