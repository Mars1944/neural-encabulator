{
  "_doc": {
    "purpose": "Consolidated config for prototype two (paths, data, model, training, inference, viewer)",
    "usage": [
      "Infer: python infer.py --config config.json",
      "Viewer: python heatmap_viewer.py --config heatmap_viewer_config.json or point to this file"
    ]
  },

  "paths": {
    "outputs_root": "data/outputs"
  },
  "seed": 42,
  "device": "auto",
  "model_type": "cnn",

  "data": {
    "data_kind": "image",
    "train_image_dir": "data/training data/image/training_image_root.txt",
    "test_image_dir": "data/testing data/testing_image_root.txt",
    "image_size": [256, 256],
    "image_channels": 3,
    "tile_size": [256, 256],
    "tile_stride": [256, 256],
    "add_magnitude": true,
    "normalize": true,
    "limit_tiles": null
  },

  "model": {
    "num_classes": 2,
    "conv_channels": [32, 64, 128, 256],
    "kernel_size": 3,
    "pool_every": 1,
    "dropout": 0.1,
    "use_batchnorm": true,
    "dilations": [1, 2, 4, 4]
  },

  "training": {
    "task": "multitask",
    "train_flow_csv": "C:/Users/Owner/Documents/Grad School/Fall 2025/ME 521 - CPTS 534 Project/neural_encabulator_training_testing_data/training data/metadata_set_one.csv",
    "debug_limit_training": false,
    "debug_train_fraction": 0.2,
    "batch_size": 48,
    "num_workers": 4,
    "pin_memory": true,
    "mixed_precision": false,
    "channels_last": false,
    "val_source_labels":[0,1],
    "val_split": 0.2,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "optimizer": "adamw",
    "scheduler": "none",
    "max_epochs": 50,
    "train_source_labels": [2, 1]
  },

  "inference": {
    "common": {
      "data_kind": "image",
      "use_test": true,
      "file_labels": "C:/Users/Owner/Documents/Grad School/Fall 2025/ME 521 - CPTS 534 Project/neural_encabulator_training_testing_data/testing_data/file_name.csv",
      "file_summary": "data/outputs/image/file_predictions.csv",
      "recurse": true,
      "generate_heatmap": true,
      "generate_confusion_matrix": true,
      "show_heatmap": false,
      "heatmap_class": 0,
      "cm_csv": "data/outputs/image/confusion_matrix.csv",
      "cm_png": "data/outputs/image/confusion_matrix.png",
      "heatmaps_dir": "data/outputs/heatmaps",
      "stitched_heatmap": "data/outputs/stitched_heatmap.png",
      "class_names": ["turbulent", "laminar"],
      "mixed_precision": "fp16",
      "channels_last": true,
      "pin_memory": true,
      "prefetch_workers": 0,
      "torch_compile": false,
      "use_inference_mode": true,
      "allow_tf32": true,
      "use_opencv_loader": false,
      "plot_top_n": 50,
      "image_include_classes": []
    },
    "image": {
      "image_infer_batch_size": 32
    },
    "vector": {
      "inference_tile_size": [77, 128],
      "inference_tile_stride": [77, 32]
    }
  },

  "reports": {
    "predictions_csv": "data/outputs/image/file_predictions.csv",
    "image_root": "data/testing data/testing_image_root.txt",
    "subdir": "image",
    "cm_csv": "data/outputs/image/confusion_matrix.csv",
    "cm_png": "data/outputs/image/confusion_matrix.png"
  },

  "viewer": {
    "viewer_values_csv": "data/testing data/heatmap_values_example.csv",
    "viewer_title": "Stitched Heatmap (Example)",
    "viewer_cmap": "viridis",
    "viewer_no_show": false,
    "viewer_save": "data/outputs/viewer_heatmap.png",
    "viewer_rows": 4,
    "viewer_cols": 4
  }
}
